<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PyMasters" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/pm_bg</item>
        <item name="android:colorBackground">@color/pm_bg</item>
        <item name="android:statusBarColor">@color/pm_bg</item>
        <item name="android:navigationBarColor">@color/pm_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.PyMasters.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PyMasters</item>
    </style>
</resources>
