# Caddy reverse proxy for PyMasters on the GCE VM. Automatic HTTPS (Let's Encrypt / ZeroSSL).
{
	email ops@pymasters.net
	# Cloudflare (free plan) proxies pymasters.net. Only requests that really come from Cloudflare's published
	# ranges (https://www.cloudflare.com/ips) may tell us the visitor's IP, via CF-Connecting-IP; anyone else
	# gets their own remote address. {client_ip} below is that result, so rate limits and the support spam
	# guard (backend: first X-Forwarded-For hop) see real visitors, and the header can't be spoofed.
	# Refresh the ranges if Cloudflare changes them (rare; listed on that page).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

pymasters.net {
	encode zstd gzip
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		# While the app container is being replaced by a rollout (~20-50 s),
		# hold requests and retry the upstream instead of returning 502.
		lb_try_duration 60s
		lb_try_interval 1s
		# When the old container is already gone and the new one is not listening yet,
		# the dial succeeds (Docker proxies the port) but the request fails: retry
		# idempotent requests a few times instead of surfacing a 502.
		lb_retries 4
		lb_retry_match {
			method GET HEAD
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

www.pymasters.net {
	redir https://pymasters.net{uri} permanent
}

# Plain-HTTP health probe by IP (no certificate needed): lets CI and the uptime
# watchdog confirm which build the VM is serving even before/without DNS.
http://35.206.69.198 {
	handle /health {
		reverse_proxy app:8080
	}
	handle {
		respond 404
	}
}
