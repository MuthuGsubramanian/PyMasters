# Caddy reverse proxy for PyMasters on the GCE VM. Automatic HTTPS (Let's Encrypt / ZeroSSL).
{
	email ops@pymasters.net
}

pymasters.net {
	encode zstd gzip
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		# While the app container is being replaced by a rollout (~20-50 s),
		# hold requests and retry the upstream instead of returning 502.
		lb_try_duration 60s
		lb_try_interval 1s
		# When the old container is already gone and the new one is not listening yet,
		# the dial succeeds (Docker proxies the port) but the request fails: retry
		# idempotent requests a few times instead of surfacing a 502.
		lb_retries 4
		lb_retry_match {
			method GET HEAD
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

www.pymasters.net {
	redir https://pymasters.net{uri} permanent
}

# Origin for the Vercel-hosted frontend (frontend/vercel.json proxies /api/* and /health here). Only Vercel
# may use it: every proxied request carries X-Origin-Secret (set by a Vercel route transform from the
# ORIGIN_SECRET env var, overwriting anything a visitor sends). With the secret, Vercel's X-Forwarded-For
# (the real client IP, which Vercel itself overwrites) is passed on so per-visitor rate limits keep working;
# without it the request is refused. ORIGIN_SECRET comes from /opt/pymasters/.env (caddy env_file).
api.pymasters.net {
	encode zstd gzip
	@vercel header X-Origin-Secret {$ORIGIN_SECRET}
	handle @vercel {
		reverse_proxy app:8080 {
			header_up -X-Origin-Secret
			# Caddy would otherwise replace an untrusted proxy's X-Forwarded-For with Vercel's own address.
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Real-IP {http.request.header.X-Forwarded-For}
			lb_try_duration 60s
			lb_try_interval 1s
			lb_retries 4
			lb_retry_match {
				method GET HEAD
			}
		}
	}
	handle {
		respond "Forbidden" 403
	}
	header -Server
}

# Plain-HTTP health probe by IP (no certificate needed): lets CI and the uptime
# watchdog confirm which build the VM is serving even before/without DNS.
http://35.206.69.198 {
	handle /health {
		reverse_proxy app:8080
	}
	handle {
		respond 404
	}
}
