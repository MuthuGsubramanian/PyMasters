[Unit]
Description=PyMasters social bot tick (render ahead at night, publish what is due)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Development/PyMasters
Environment=PYTHONPATH=%h/Documents/Development/PyMasters
Environment=HF_HOME=/mnt/eternity-store/EternityModels/pymasters-social/hf
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=VIRTUAL_ENV
ExecStart=%h/pymasters-ops/social-venv/bin/python -m socialbot tick
TimeoutStartSec=3h
Nice=15
CPUWeight=20
# Heat: the laptop power-cut itself at 100 C while rendering at full load (2026-11-02). Cap at 1.5 of 8 cores;
# pymasters-thermal-guard also pauses this unit above 82 C.
CPUQuota=150%
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=PMSOCIAL_FFMPEG_THREADS=2
