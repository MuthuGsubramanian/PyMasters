# PyMasters backend configuration — copy to `backend/.env` and fill in.
# Loaded via python-dotenv at startup (backend/main.py).
# Grouped by REQUIRED (app is broken without it) vs optional. In production these
# are supplied via Cloud Run --set-env-vars / --set-secrets (see deploy.yml), not
# this file. Most optional keys have safe defaults noted inline.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite file path. Defaults to an absolute path to backend/pymasters.db.
DB_PATH=pymasters.db

# ── Auth (REQUIRED in production) ──────────────────────────────────────────
# Used to sign JWTs (HS256). Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to start in production (K_SERVICE set) if left at the default.
JWT_SECRET=dev-insecure-secret-change-me
# Comma-separated allowlist of platform super-admin emails; resolved into the
# users.is_super_admin column at boot. Set explicitly in prod.
SUPER_ADMIN_EMAILS=muthu@pymasters.net,muthu.g.subramanian@gmail.com
# Optional: seed the first-boot 'admin' super-user with a known password (else a
# random one is generated and NOT logged). Only used on a truly empty DB.
BOOTSTRAP_ADMIN_PASSWORD=

# ── AI tutor (Vaathiyaar) — REQUIRED for any AI flow ───────────────────────
# Provider chain, tried in order. PROD PRIMARY is qubrid (Ollama is the fallback).
#   e.g. "qubrid+ollama" (prod), "ollama", "qubrid"
VAATHIYAAR_PROVIDERS=qubrid+ollama
# Qubrid (prod primary). Key at https://platform.qubrid.com.
QUBRID_API_KEY=
QUBRID_BASE_URL=https://api.qubrid.com/v1
QUBRID_MODEL=
# Ollama Cloud (fallback). Key at https://ollama.com. Connects to https://ollama.com.
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3.5
# Optional local Ollama for dev (bypasses the cloud key).
LOCAL_OLLAMA_URL=
# Model overrides for specific flows (optional; sensible defaults in code).
TRANSLATE_MODEL=
GEMINI_MODEL=

# ── App URLs ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Email notifications (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=PyMasters
# Brevo fallback (optional) — used if the primary SMTP send fails.
SMTP_BACKUP_HOST=
SMTP_BACKUP_PORT=
SMTP_BACKUP_USER=
SMTP_BACKUP_PASS=
# Support / tutor-session / org-request notification recipients (comma-separated).
# Fallback only — a super admin can override these in the console Settings tab.
NOTIFY_EMAILS=muthu@pymasters.net,muthu.g.subramanian@gmail.com

# ── OAuth social login (optional) ──────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/api/auth/linkedin/callback

# ── Payments (Razorpay Standard Checkout, optional) ────────────────────────
# KEY_ID is publishable (sent to the browser); KEY_SECRET is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── WhatsApp notifications (optional, Twilio) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Ops tokens (optional; REQUIRED for the automation/export jobs) ─────────
# Bearer token the export endpoint requires.
EXPORT_TOKEN=
# Bearer token the social/ops worker uses to call the prod job API.
SOCIAL_WORKER_TOKEN=

# ── Semantic curriculum index (vector search, optional) ────────────────────
# SEMANTIC_AUTOSTART: "1" force-on, "0" kill switch, unset = auto under K_SERVICE.
SEMANTIC_AUTOSTART=
SEMANTIC_MODEL=
SEMANTIC_CACHE_DIR=
SEMANTIC_EMBED_BATCH=
SEMANTIC_FAKE_EMBED=          # tests only
HELIX_URL=                    # optional HelixDB backend

# ── Inactive-account lifecycle (optional; safe defaults in code) ───────────
LIFECYCLE_DELETE_ENABLED=     # "1" to enable hard-delete after grace
LIFECYCLE_INACTIVITY_DAYS=
LIFECYCLE_GRACE_DAYS=

# ── Voice / translation / misc (optional) ──────────────────────────────────
VOICE_WHISPER_MODEL=tiny      # server-side STT model size
WHISPER_MODEL=                # alias used by some tooling
LESSON_TRANSLATION_ONDEMAND=  # "0" disables on-demand lesson-body translation

# ── GCP / podcasts / TTS (optional, advanced) ──────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
PODCAST_BUCKET=
PODCAST_PUBLIC_BASE=
PODCAST_SCRIPT_MODEL=
PIPER_BIN=
PIPER_VOICES_JSON=
PARLER_MODEL=
PARLER_DESCRIPTIONS_JSON=
TTS_ENGINE_MAP_JSON=
